rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin allowlist ──────────────────────────────────────────────────────
    // Document IDs are lower-cased admin emails. There is no self-service way
    // to add one — they're added by hand in the Firebase console — so a signed
    // in user can only ever confirm their own admin status, never anyone
    // else's or write themselves in.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /admins/{email} {
      allow get: if request.auth != null
                 && request.auth.token.email != null
                 && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // ── Newsletter subscribers ────────────────────────────────────────────────
    // Anyone can subscribe (no auth required for the lead magnet).
    // Reads and deletes are blocked — subscriber data stays server-side only.
    match /newsletter_subscribers/{email} {
      allow create, update: if request.resource.data.email is string
                            && request.resource.data.email.matches('.*@.*')
                            && request.resource.data.email == email;
      allow read, delete: if false;
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    // Users can only read and write their own profile document.
    // The document ID always matches the Firebase Auth UID.
    //
    // Writes are restricted to the known profile fields. Without this a signed-in
    // user could add arbitrary keys to their own document — including any field
    // we might later come to treat as privileged (a role or staff flag).
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasOnlyAllowedFields() {
        return request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'mobileNumber', 'provider', 'createdAt'
        ]);
      }

      allow read: if isOwner() || isAdmin();

      allow create: if isOwner()
                    && hasOnlyAllowedFields()
                    && request.resource.data.email is string;

      allow update: if isOwner()
                    && hasOnlyAllowedFields()
                    // The email is set at sign-up and must not drift from Auth.
                    && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }

    // ── Bookings ──────────────────────────────────────────────────────────────
    // Read-only from the client. Every write goes through the createBooking,
    // cancelBooking and rescheduleBooking callables, which run as admin.
    //
    // Client writes used to be allowed as long as `userId` matched the caller,
    // which left the email address, price, time and status to the browser —
    // and onBookingCreated mails whatever address it finds on the document.
    match /bookings/{bookingId} {
      allow create, update, delete: if false;

      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
