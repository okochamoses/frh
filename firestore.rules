rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Newsletter subscribers ────────────────────────────────────────────────
    // Anyone can subscribe (no auth required for the lead magnet).
    // Reads and deletes are blocked — subscriber data stays server-side only.
    match /newsletter_subscribers/{email} {
      allow create, update: if request.resource.data.email is string
                            && request.resource.data.email.matches('.*@.*')
                            && request.resource.data.email == email;
      allow read, delete: if false;
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    // Users can only read and write their own profile document.
    // The document ID always matches the Firebase Auth UID.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Bookings ──────────────────────────────────────────────────────────────
    // Users can create bookings for themselves and read their own bookings.
    // Update and delete are intentionally blocked from the client.
    match /bookings/{bookingId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow read:   if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }
  }
}
