{
  "name": "flourish",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next export",
    "dev:emulator": "NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true next dev --turbopack",
    "emulators:kill": "./scripts/kill-emulators.sh",
    "sync:services": "node scripts/sync-services.mjs",
    "optimise:images": "node scripts/optimise-images.mjs",
    "images:variants": "node scripts/generate-image-variants.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,functions --project demo-flourish",
    "emulators:export": "firebase emulators:start --only auth,firestore,functions --project demo-flourish --import ./.emulator-data --export-on-exit",
    "maildev": "maildev --ip 127.0.0.1 --smtp 1025 --web 1080",
    "predev:local": "./scripts/kill-emulators.sh",
    "dev:local": "concurrently -k -n maildev,emulators,next -c yellow,magenta,cyan \"npm run maildev\" \"npm run emulators\" \"wait-on tcp:127.0.0.1:9099 && npm run dev:emulator\"",
    "build:e2e": "NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true next build && rm -rf out-e2e && mv out out-e2e",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build:e2e && E2E_TARGET=export playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:baseline": "playwright test --grep-invert @known-bug",
    "test:e2e:report": "playwright show-report",
    "test:install": "playwright install chromium webkit"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@fortawesome/react-fontawesome": "^3.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "axios": "1.15.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.6.3",
    "googleapis": "^160.0.0",
    "gsap": "^3.12.7",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "next": "15.1.7",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-fast-marquee": "^1.6.5",
    "react-icons": "^5.5.0",
    "swiper": "^12.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "concurrently": "^9.2.4",
    "firebase-tools": "^14.27.0",
    "maildev": "^2.2.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9.2",
    "wait-on": "^8.0.5"
  }
}
